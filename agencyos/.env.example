# Core
NODE_ENV=development
DATABASE_URL=postgresql://agencyos:agencyos_dev@127.0.0.1:5432/agencyos?schema=public
TEST_DATABASE_URL=postgresql://agencyos:agencyos_dev@127.0.0.1:5432/agencyos_test?schema=public
API_PORT=4000
WEB_URL=http://localhost:3000
# Internal server-side proxy target. Never use localhost in browser-side code.
API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=/api/v1
# Generate unique random values for real environments (minimum 32 characters).
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false
# Optional providers: leave blank to expose explicit unavailable states.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RESEND_API_KEY=
EMAIL_FROM=AgencyOS <onboarding@resend.dev>
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
SENTRY_DSN=
# Local development only: exposes deterministic demo credentials on the login screen.
NEXT_PUBLIC_DEMO_MODE=true
