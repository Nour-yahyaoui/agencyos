{
  "name": "@agencyos/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --config jest.config.js --runInBand",
    "test:integration": "dotenv-cli -e ../../.env -- jest --config test/jest-integration.config.js --runInBand",
    "db:generate": "dotenv-cli -e ../../.env -- prisma generate",
    "db:migrate": "dotenv-cli -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv-cli -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv-cli -e ../../.env -- tsx prisma/seed.ts",
    "db:seed:activity": "dotenv-cli -e ../../.env -- tsx prisma/seed-demo-activity.ts",
    "db:studio": "dotenv-cli -e ../../.env -- prisma studio",
    "openapi": "nest build && dotenv-cli -e ../../.env -- node dist/scripts/export-openapi.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.18.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "openai": "^6.7.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.3.0",
    "rxjs": "^7.8.2",
    "stripe": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9.38.0",
    "jest": "^30.2.0",
    "prisma": "^6.18.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
